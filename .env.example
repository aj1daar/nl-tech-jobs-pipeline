# Copy to .env for local dev. Read by docker compose, make, and the Python code.
# Plain KEY=value only, no quotes: make parses this file too.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=nl_jobs
POSTGRES_USER=nl_jobs
POSTGRES_PASSWORD=change-me-locally

# iwwz sponsor export. Always empty in this file, which is committed.
# Locally, set the key in your gitignored .env or export it in your shell.
# In production the runner supplies it (systemd EnvironmentFile or a secret store).
IWWZ_EXPORT_URL=
IWWZ_API_KEY=
