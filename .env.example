# Copy to .env for local dev. Read by docker compose, make, and the Python code.
# Plain KEY=value only, no quotes: make parses this file too.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=nl_jobs
POSTGRES_USER=nl_jobs
POSTGRES_PASSWORD=change-me-locally

# iwwz sponsor export. Leave both empty here and in .env.
# The key is supplied by whoever runs the pipeline (a shell export for a one-off run,
# a systemd EnvironmentFile or a secret store in production), never by a file in this repo.
IWWZ_EXPORT_URL=
IWWZ_API_KEY=
